# Worker-only local environment. NEVER put these values in web/, api/, GitHub,
# or any NEXT_PUBLIC_* variable. Use the local Supabase CLI service role key
# for development and deploy secrets via a private runtime secret store.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
WHISPER_MODEL=tiny
