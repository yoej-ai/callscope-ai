# Worker-only local environment. NEVER put these values in web/, api/, GitHub,
# or any NEXT_PUBLIC_* variable. Keep deployed credentials in a private runtime
# secret store. All example values below are fake.

# Supabase worker-only privileged access.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace-with-worker-secret

# Legacy JWT compatibility only; do not set both key variables to different values.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-jwt

# Local transcription engine.
WHISPER_MODEL=tiny

# Local AI analysis engine.
# Development/testing uses Ollama locally with zero paid API/service cost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Optional local speaker diarization. Keep the gated model token worker-only.
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1
# HF_TOKEN=replace-with-worker-only-read-token
PYANNOTE_METRICS_ENABLED=0
