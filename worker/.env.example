# Worker-only local environment. NEVER put these values in web/, api/, GitHub,
# or any NEXT_PUBLIC_* variable. Keep deployed credentials in a private runtime
# secret store. All example values below are fake.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_replace-with-worker-secret
# Legacy JWT compatibility only; do not set both key variables to different values.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-jwt
WHISPER_MODEL=tiny
